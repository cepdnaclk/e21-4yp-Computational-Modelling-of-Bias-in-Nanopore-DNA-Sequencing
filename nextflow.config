// Runtime settings. The experiment itself (factors, levels, resources) lives in
// config/experiment.yaml, which run_pipeline.sh passes as -params-file.

manifest {
    name = 'e21-4yp-nanopore-bias'
    description = 'Phase 1: composition bias across basecalling, QC, host mapping and classification'
    nextflowVersion = '>=25.04'
}

conda.enabled = true

// Tasks keep temp files inside the home directory (shared server).
env {
    TMPDIR = "${System.getenv('HOME')}/tmp"
}

executor {
    name = 'local'
    cpus = 64
    memory = '300 GB'
}

process {
    cpus = 8
    memory = '16 GB'
    errorStrategy = 'finish'

    // Existing conda environments (created from envs/*.yml) are used directly.
    withLabel: basecall { conda = "${System.getenv('HOME')}/anaconda3/envs/env-basecall" }
    withLabel: qc       { conda = "${System.getenv('HOME')}/anaconda3/envs/env-qc" }
    withLabel: align    { conda = "${System.getenv('HOME')}/anaconda3/envs/env-align" }
    withLabel: classify { conda = "${System.getenv('HOME')}/anaconda3/envs/env-classify"; memory = '32 GB' }
    withLabel: blast    { conda = "${System.getenv('HOME')}/anaconda3/envs/env-analysis" }
    // One GPU job at a time; each uses all 4 GPUs through cuda:all.
    withLabel: gpu      { maxForks = 1; cpus = 16; memory = '32 GB' }
}
